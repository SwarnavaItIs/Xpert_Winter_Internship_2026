# Documentation only: scripts read the process environment, not this file.
# Configure these locally; never put a real key in this template.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_API_KEY=
# Optional target runtime, seconds; 60..1680. Parent process adds 60 seconds.
LLM_RUNTIME_SECONDS=1680
# Per-run transport ceilings; these are not verified monetary limits.
LLM_MAX_REQUESTS=1000
# Reservation units are request bytes + maximum output tokens, per attempt.
# This is a transport bound, NOT a dollar cap or billed-token measurement.
LLM_MAX_TOKEN_UNITS=20000000
LLM_REQUEST_TIMEOUT_SECONDS=90
# OpenRouter :free defaults to 4 seconds between request starts, including retries.
# Other endpoints default to 0. This does not bypass account daily quotas.
LLM_MIN_REQUEST_INTERVAL_SECONDS=4
# Strict boolean verification schemas default on for the named Nemotron route.
# Other compatible endpoints use JSON-object mode by default.
LLM_JSON_SCHEMA_VERDICTS=1
# Disable reasoning for the named Nemotron route.
# Other models default to 0; do not set 1 for an unsupported route.
LLM_DISABLE_REASONING=1
# Optional safe stage/request progress on stderr; never prints chats or credentials.
XPERT_PROGRESS=1
